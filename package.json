{
  "name": "pixel-kampung",
  "version": "0.20.0",
  "private": true,
  "description": "An AI-first pixel life-sim: a 1960s Singapore kampung run by AI residents.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "sim": "node --disable-warning=ExperimentalWarning src/cli/sim.ts",
    "save-fixture": "node --disable-warning=ExperimentalWarning test/make-save-fixture.ts",
    "start": "node --disable-warning=ExperimentalWarning src/cli/serve.ts",
    "test": "vitest run",
    "test:page": "vitest run --config vitest.page.config.ts",
    "trial": "node --disable-warning=ExperimentalWarning src/cli/trial.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "watch": "node --disable-warning=ExperimentalWarning src/cli/watch.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.2.0",
    "esbuild": "0.28.2",
    "phaser": "3.90.0"
  }
}
